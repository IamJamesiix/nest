PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nest
JWT_SECRET=put-any-long-random-text-here
JWT_EXPIRES_IN=7d

# OAU Ile-Ife main campus (used to work out distance from school)
CAMPUS_LAT=7.5186
CAMPUS_LNG=4.5225

# listings not reconfirmed within this many days become "expired"
LISTING_EXPIRY_DAYS=30

# Google sign-in: OAuth "Web application" client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
